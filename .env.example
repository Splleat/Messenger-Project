# JWT
SECRET_KEY=this-is-a-test-secret-key-with-at-least-32-characters-long

# TSID
TSID_NODE=0

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=my_db
MYSQL_USER=user
MYSQL_PASSWORD=change-me

# MinIO
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
MINIO_BUCKET=messenger
MINIO_CORS_ALLOW_ORIGIN=http://localhost:3000

# CORS 허용 오리진 (로컬)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 프로덕션

# 프론트 도메인 (앱 CORS)
FRONT_ORIGIN=https://splleat.com

# RDS (MySQL)
DB_HOST=your-db.xxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
MYSQL_DATABASE=my_db
MYSQL_USER=admin
MYSQL_PASSWORD=change-me-strong

# S3
S3_REGION=ap-northeast-2
S3_BUCKET=splleat-messenger-attachments

# Caddy ACME 등록 이메일
ACME_EMAIL=splleat@gmail.com

# Grafana (prod는 기본값 없음, 반드시 지정)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong
